READING_DATA_DIR=/var/lib/books
READING_PUSH_ENABLED=0
# Use chatgpt to share the standalone webpage's AI notes and replies with ChatGPT.
# Keep codex for an existing Home / Books MCP room.
READING_WEB_CHANNEL=codex

READING_HUMAN_LABEL=我
READING_AI_LABEL=共读者

# Independent server-to-server identities; never reuse either value.
READING_MCP_CONTROL_TOKEN=replace-with-home-control-token
READING_CHATGPT_CONTROL_TOKEN=replace-with-chatgpt-control-token
